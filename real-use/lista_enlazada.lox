// LISTA ENLAZADA 

class Nodo {}
class Lista {}

fun crearNodo(dato) {
    var nodo = Nodo();
    nodo.dato = dato;
    nodo.proximo = nil;
    return nodo;
}

fun crearLista() {
    var lista = Lista();
    lista.primero = nil;
    lista.ultimo = nil;
    lista.cantidad = 0;
    return lista;
}

fun estaVacia(lista) {
    return lista.cantidad == 0;
}

fun insertarPrimero(lista, dato) {
    var nodo = crearNodo(dato);
    nodo.proximo = lista.primero;
    if (estaVacia(lista)) lista.ultimo = nodo;
    lista.primero = nodo;
    lista.cantidad = lista.cantidad + 1;
}

fun insertarUltimo(lista, dato) {
    var nodo = crearNodo(dato);
    if (estaVacia(lista)) {
        lista.primero = nodo;
    } else {
        lista.ultimo.proximo = nodo;
    }
    lista.ultimo = nodo;
    lista.cantidad = lista.cantidad + 1;
}

fun borrarPrimero(lista) {
    if (estaVacia(lista)) return nil;
    var dato = lista.primero.dato;
    lista.primero = lista.primero.proximo;
    if (lista.primero == nil) lista.ultimo = nil;
    lista.cantidad = lista.cantidad - 1;
    return dato;
}

fun verPrimero(lista) {
    if (estaVacia(lista)) return nil;
    return lista.primero.dato;
}

fun largo(lista) {
    return lista.cantidad;
}

fun iterar(lista, visitar) {
    var actual = lista.primero;
    while (actual != nil) {
        if (!visitar(actual.dato)) break;
        actual = actual.proximo;
    }
}

// HELPERS PARA LOS TESTS

fun sonIguales(a, b) {
    if (largo(a) != largo(b)) return false;
    var actualA = a.primero;
    var actualB = b.primero;
    while (actualA != nil) {
        if (actualA.dato != actualB.dato) return false;
        actualA = actualA.proximo;
        actualB = actualB.proximo;
    }
    return true;
}

fun verificar(condicion) {
    if (condicion) {
        print "OK";
    } else {
        print "ERROR";
    }
}

fun armarListaDesordenada(cantidad) {
    var lista = crearLista();

    for (var i = 0; i < cantidad; i = i + 1) {
        insertarUltimo(lista, (i * 7) % cantidad);
    }

    return lista;
}

fun armarListaConRepetidos() {
    var lista = crearLista();

    insertarUltimo(lista, 3);
    insertarUltimo(lista, 1);
    insertarUltimo(lista, 3);
    insertarUltimo(lista, 4);
    insertarUltimo(lista, 3);

    return lista;
}

fun armarListaConRepetidosOrdenada() {
    var lista = crearLista();

    insertarUltimo(lista, 1);
    insertarUltimo(lista, 3);
    insertarUltimo(lista, 3);
    insertarUltimo(lista, 3);
    insertarUltimo(lista, 4);

    return lista;
}

fun armarListaOrdenada(cantidad) {
    var lista = crearLista();

    for (var i = 0; i < cantidad; i = i + 1) {
        insertarUltimo(lista, i);
    }

    return lista;
}

// MERGESORT

fun mergeSort(lista) {
    // caso base: si tiene 0 o 1 elemento ya está ordenada
    if (lista.cantidad <= 1) return lista;

    var medio = lista.cantidad / 2;
    var izquierda = obtenerIzquierda(lista, medio);
    var derecha = lista; // a la original le quedó la otra mitad

    var izquierdaOrdenada = mergeSort(izquierda);
    var derechaOrdenada = mergeSort(derecha);

    return merge(izquierdaOrdenada, derechaOrdenada);
}

fun obtenerIzquierda(lista, medio) {
    var izquierda = crearLista();
    for (var i = 0; i < medio; i = i + 1) {
        var elem = borrarPrimero(lista);
        insertarUltimo(izquierda, elem);
    }
    return izquierda;
}

fun merge(izquierda, derecha) {
    var resultado = crearLista();

    while (!estaVacia(izquierda) and !estaVacia(derecha)) {
        if (verPrimero(izquierda) <= verPrimero(derecha)) {
            insertarUltimo(resultado, borrarPrimero(izquierda));
        } else {
            insertarUltimo(resultado, borrarPrimero(derecha));
        }
    }

    // lo que sobra de una de las dos ya está ordenado
    while (!estaVacia(izquierda)) {
        insertarUltimo(resultado, borrarPrimero(izquierda));
    }
    while (!estaVacia(derecha)) {
        insertarUltimo(resultado, borrarPrimero(derecha));
    }

    return resultado;
}

// MERGESORT TESTS

print "********** MERGESORT **********";
print " ";

print "--- MERGESORT CON LISTA DESORDENADA ---";
var desordenadaMergeSort = armarListaDesordenada(50);
var esperada = armarListaOrdenada(50);
verificar(sonIguales(mergeSort(desordenadaMergeSort), esperada));

print "--- MERGESORT CON UNA LISTA VACIA ---";
verificar(estaVacia(mergeSort(crearLista())));

print "--- MERGESORT CON REPETIDOS ---";
var conRepetidosMergeSort = armarListaConRepetidos();
var esperadaConRepetidos = armarListaConRepetidosOrdenada();
verificar(sonIguales(mergeSort(conRepetidosMergeSort), esperadaConRepetidos));

print "--- MERGESORT LISTA YA ORDENADA ---";
var ordenadaMergeSort = armarListaOrdenada(50);
var ordenada = armarListaOrdenada(50);
verificar(sonIguales(mergeSort(ordenadaMergeSort), ordenada));

// QUICKSORT

fun quickSort(lista) {
    if (lista.cantidad <= 1) return lista;

    var pivote = borrarPrimero(lista);

    var menores = crearLista();
    var mayores = crearLista();
    while (!estaVacia(lista)) {
        var elemento = borrarPrimero(lista);
        if (elemento < pivote) {
            insertarUltimo(menores, elemento);
        } else {
            insertarUltimo(mayores, elemento);
        }
    }

    var quickMenores = quickSort(menores); 
    var quickMayores = quickSort(mayores);

    var listaOrdenada = crearLista();
    while (!estaVacia(quickMenores)) {
        var elem = borrarPrimero(quickMenores);
        insertarUltimo(listaOrdenada, elem);
    }
    insertarUltimo(listaOrdenada, pivote);
    while (!estaVacia(quickMayores)) {
        var elem = borrarPrimero(quickMayores);
        insertarUltimo(listaOrdenada, elem);
    }

    return listaOrdenada;
}

// QUICKSORT TESTS

print " ";
print "********** QUICKSORT **********";
print " ";

print "--- QUICKSORT CON LISTA DESORDENADA ---";
var desordenadaQuickSort = armarListaDesordenada(50);
var esperada = armarListaOrdenada(50);
verificar(sonIguales(quickSort(desordenadaQuickSort), esperada));

print "--- QUICKSORT CON UNA LISTA VACIA ---";
verificar(estaVacia(quickSort(crearLista())));

print "--- QUICKSORT CON REPETIDOS ---";
var conRepetidosQuickSort = armarListaConRepetidos();
var esperadaConRepetidos = armarListaConRepetidosOrdenada();
verificar(sonIguales(quickSort(conRepetidosQuickSort), esperadaConRepetidos));

print "--- QUICKSORT LISTA YA ORDENADA ---";
var ordenadaQuickSort = armarListaOrdenada(50);
var ordenada = armarListaOrdenada(50);
verificar(sonIguales(quickSort(ordenadaQuickSort), ordenada));

// BUBBLESORT

fun bubbleSort(lista) {
    for (var i = 0; i < lista.cantidad; i = i + 1) {
        var actual = lista.primero;
        while (actual != nil and actual.proximo != nil) {
            if (actual.dato > actual.proximo.dato) {
                var aux = actual.dato;
                actual.dato = actual.proximo.dato;
                actual.proximo.dato = aux;
            }
            actual = actual.proximo;
        }
    }
    return lista;
}

// BUBBLESORT TESTS

print " ";
print "********** BUBBLESORT **********";
print " ";

print "--- BUBBLESORT CON LISTA DESORDENADA ---";
var desordenadaBubbleSort = armarListaDesordenada(50);
var esperada = armarListaOrdenada(50);
verificar(sonIguales(bubbleSort(desordenadaBubbleSort), esperada));

print "--- BUBBLESORT CON UNA LISTA VACIA ---";
verificar(estaVacia(quickSort(crearLista())));

print "--- BUBBLESORT CON REPETIDOS ---";
var conRepetidosBubbleSort = armarListaConRepetidos();
var esperadaConRepetidos = armarListaConRepetidosOrdenada();
verificar(sonIguales(bubbleSort(conRepetidosBubbleSort), esperadaConRepetidos));

print "--- BUBBLESORT LISTA YA ORDENADA ---";
var ordenadaBubbleSort = armarListaOrdenada(50);
var ordenada = armarListaOrdenada(50);
verificar(sonIguales(bubbleSort(ordenadaBubbleSort), ordenada));
