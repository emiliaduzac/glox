print "--- CONTINUE EN WHILE ---";
var i = 0;
var sum = 0;
while (i < 5) {
    i = i + 1;
    if (i == 3) continue;
    sum = sum + i;
}

if (sum == 12) {
    print "OK";
} else {
    print "ERROR";
}

print "--- CONTINUE EN FOR (ejecuta el incremento) ---";
var sumFor = 0;
for (var j = 0; j < 5; j = j + 1) {
    if (j == 2) continue;
    sumFor = sumFor + j;
}

if (sumFor == 8) {
    print "OK";
} else {
    print "ERROR";
}

print "--- BREAK EN WHILE ---";
var n = 0;
while (true) {
    n = n + 1;
    if (n == 4) break;
}

if (n == 4) {
    print "OK";
} else {
    print "ERROR";
}

print "--- BREAK EN FOR ---";
var last = 0;
for (var k = 0; k < 10; k = k + 1) {
    last = k;
    if (k == 6) break;
}

if (last == 6) {
    print "OK";
} else {
    print "ERROR";
}

print "--- VARIABLES LOCALES EN EL CUERPO ---";
var total = 0;
for (var a = 0; a < 6; a = a + 1) {
    var doble = a * 2;
    if (a == 1) continue;
    var triple = a * 3;
    if (a == 4) break;
    total = total + doble + triple;
}

if (total == 25) {
    print "OK";
} else {
    print "ERROR";
}

print "--- CICLOS ANIDADOS: BREAK SOLO SALE DEL MAS INTERNO ---";
var countBreak = 0;
for (var x = 0; x < 3; x = x + 1) {
    for (var y = 0; y < 3; y = y + 1) {
        if (y == 1) break;
        countBreak = countBreak + 1;
    }
}

if (countBreak == 3) {
    print "OK";
} else {
    print "ERROR";
}

print "--- CICLOS ANIDADOS: CONTINUE SOLO AFECTA AL MAS INTERNO ---";
var countContinue = 0;
for (var p = 0; p < 3; p = p + 1) {
    for (var q = 0; q < 3; q = q + 1) {
        if (q == 1) continue;
        countContinue = countContinue + 1;
    }
}

if (countContinue == 6) {
    print "OK";
} else {
    print "ERROR";
}

print "--- BREAK Y CONTINUE DENTRO DE BLOQUES ANIDADOS ---";
var m = 0;
var seen = 0;
while (true) {
    var v = m;
    m = m + 1;
    {
        var w = v;
        if (w == 2) break;
    }
    if (v == 0) continue;
    seen = seen + v;
}

if (seen == 1 and m == 3) {
    print "OK";
} else {
    print "ERROR";
}

print "--- BREAK Y CONTINUE DENTRO DE UNA FUNCION ---";
fun sumUntil(n) {
    var s = 0;
    var i = 0;
    while (true) {
        i = i + 1;
        if (i > n) break;
        if (i == 3) continue;
        s = s + i;
    }
    return s;
}
if (sumUntil(5) == 12) {
    print "OK";
} else {
    print "ERROR";
}

print "--- CONTINUE EN UN FOR DENTRO DE UNA FUNCION (con variable local) ---";
fun sumSkipping(skip, n) {
    var s = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = i * 2;
        if (i == skip) continue;
        s = s + x;
    }
    return s;
}
if (sumSkipping(2, 5) == 16) {
    print "OK";
} else {
    print "ERROR";
}

print "--- LOS PARAMETROS SIGUEN INTACTOS DESPUES DE UN BREAK ---";
fun keepsParams(a, b) {
    while (true) {
        var t = a + b;
        if (t > 0) break;
    }
    return a * 10 + b;
}
if (keepsParams(1, 2) == 12) {
    print "OK";
} else {
    print "ERROR";
}

print "--- CICLOS ANIDADOS DENTRO DE UNA FUNCION ---";
fun nestedLoops() {
    var c = 0;
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            if (j == 1) continue;
            if (i == 2) break;
            c = c + 1;
        }
    }
    return c;
}
if (nestedLoops() == 4) {
    print "OK";
} else {
    print "ERROR";
}

print "--- RETURN DENTRO DE UN CICLO CON VARIABLE LOCAL ---";
fun returnInLoop() {
    for (var i = 0; i < 10; i = i + 1) {
        var x = i * 2;
        if (i == 3) return x;
    }
}
if (returnInLoop() == 6) {
    print "OK";
} else {
    print "ERROR";
}

print "--- CADA LLAMADA RECURSIVA TIENE SU PROPIO CICLO ---";
fun depth(n) {
    for (var i = 0; i < 10; i = i + 1) {
        if (i == 1) break;
    }
    if (n == 0) return 0;
    return 1 + depth(n - 1);
}
if (depth(5) == 5) {
    print "OK";
} else {
    print "ERROR";
}

print "--- FUNCION DECLARADA DENTRO DE UN CICLO, CON SU PROPIO BREAK ---";
var total = 0;
for (var k = 0; k < 3; k = k + 1) {
    fun count() {
        var c = 0;
        while (true) {
            c = c + 1;
            if (c == 4) break;
        }
        return c;
    }
    total = total + count();
}

if (total == 12) {
    print "OK";
} else {
    print "ERROR";
}
